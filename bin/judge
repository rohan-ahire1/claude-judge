#!/usr/bin/env bash
# Wrapper so the slash command can invoke `${CLAUDE_PLUGIN_ROOT}/bin/judge`
# without depending on the user activating the venv.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
VENV_PY="$ROOT/.venv/bin/python"

if [[ ! -x "$VENV_PY" ]]; then
  echo "claude-judge: venv not found at $VENV_PY" >&2
  echo "Run: cd $ROOT && uv venv --python 3.13 .venv && uv pip install -e ." >&2
  exit 1
fi

exec "$VENV_PY" -m claude_judge.cli "$@"
